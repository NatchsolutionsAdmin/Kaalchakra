#!/usr/bin/env bash
# Kaalchakra — one command for everything you need to run locally.
#
#   ./dev            list what it can do
#   ./dev play       play the game  (add a shape: phone | tall | tablet | wide)
#   ./dev prologue   read the Prologue script in-engine
#   ./dev test       run the smoke test
#   ./dev vo         regenerate the voice recording sheet
#   ./dev shots      render reference screenshots of all three eras
#   ./dev edit       open the project in the Godot editor
#   ./dev import     re-import assets (after pulling, or if things look odd)
#   ./dev doctor     check this machine: Godot, Git LFS, phone build tools
#
# Nothing here is needed to work on the game. It just saves typing the long
# path to Godot every time.

set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GAME="$ROOT/game"

# Find Godot, preferring a version that matches the one the project is locked
# to (decision #21). Override with:  GODOT=/path/to/Godot ./dev play
LOCKED="4.7.2"
find_godot() {
  if [[ -n "${GODOT:-}" ]]; then echo "$GODOT"; return; fi
  for c in "/Applications/Godot.app/Contents/MacOS/Godot" \
           "$HOME/Applications/Godot.app/Contents/MacOS/Godot" \
           "$(command -v godot 2>/dev/null || true)"; do
    [[ -x "$c" ]] && { echo "$c"; return; }
  done
  echo ""
}
GODOT_BIN="$(find_godot)"

need_godot() {
  if [[ -z "$GODOT_BIN" ]]; then
    echo "Godot not found."
    echo "Install it to /Applications, or run:  GODOT=/path/to/Godot ./dev $1"
    exit 1
  fi
}

run()  { need_godot "$1"; shift; "$GODOT_BIN" --path "$GAME" "$@"; }
headless() { need_godot "$1"; shift; "$GODOT_BIN" --headless --path "$GAME" "$@"; }

case "${1:-help}" in
  play)
    # Real phones in landscape are far wider than a 16:9 window, and tablets
    # are squarer. Testing the actual proportions catches UI that only fits
    # on a desktop.  ./dev play phone
    case "${2:-phone}" in
      phone)  RES="1230x568" ; NOTE="19.5:9 — iPhone 15 / most modern phones" ;;
      tall)   RES="1200x540" ; NOTE="20:9 — many Android phones" ;;
      tablet) RES="1180x820" ; NOTE="1.44:1 — iPad" ;;
      wide)   RES="1280x720" ; NOTE="16:9 — older phones and desktop" ;;
      *)      RES="$2"       ; NOTE="custom" ;;
    esac
    echo "window $RES  ($NOTE)"
    run play --resolution "$RES"
    ;;
  prologue)
    echo "Tap to advance. Tap again while text types to finish the line."
    run prologue scenes/dev/Prologue.tscn --resolution "${2:-1230x568}"
    ;;
  test)
    headless test scenes/dev/SmokeTest.tscn --quit-after 12000
    ;;
  vo)
    headless vo scenes/dev/VOManifest.tscn --quit-after 600
    ;;
  shots)
    OUT="${2:-$ROOT/.shots}"
    mkdir -p "$OUT"
    SHOT_DIR="$OUT" run shots scenes/dev/Shots.tscn --quit-after 6000
    echo "screenshots in $OUT"
    ;;
  edit)
    need_godot edit
    "$GODOT_BIN" --editor --path "$GAME" &
    echo "opening the editor..."
    ;;
  import)
    headless import --import
    echo "re-imported."
    ;;
  doctor)
    echo "Kaalchakra — local setup"
    echo
    if [[ -n "$GODOT_BIN" ]]; then
      V="$("$GODOT_BIN" --version 2>/dev/null | head -1)"
      if [[ "$V" == "$LOCKED"* ]]; then
        echo "  ok    Godot $V"
      else
        echo "  WARN  Godot $V — the project is locked to $LOCKED (decision #21)."
        echo "        A different editor can silently rewrite scene files."
      fi
    else
      echo "  MISS  Godot not found. Install 4.7.2 to /Applications."
    fi

    command -v git >/dev/null && echo "  ok    $(git --version)" || echo "  MISS  git"
    if git lfs version >/dev/null 2>&1; then
      echo "  ok    $(git lfs version | head -1)"
    else
      echo "  MISS  git-lfs — needed for art and audio.  brew install git-lfs"
    fi

    echo
    echo "  Phone builds"
    TPL="$HOME/Library/Application Support/Godot/export_templates"
    if [[ -d "$TPL" ]] && [[ -n "$(ls -A "$TPL" 2>/dev/null)" ]]; then
      echo "  ok    export templates: $(ls "$TPL" | tr '\n' ' ')"
    else
      echo "  MISS  export templates. Godot: Editor > Manage Export Templates > Download (~1 GB)."
      echo "        Needed for ANY phone build, Android or iOS."
    fi

    SDK="$HOME/Library/Android/sdk"
    if [[ -d "$SDK" ]]; then
      echo "  ok    Android SDK at $SDK"
      [[ -d "$SDK/build-tools" ]] && echo "        build-tools: $(ls "$SDK/build-tools" | tr '\n' ' ')"
      if [[ -x "$SDK/platform-tools/adb" ]]; then
        N="$("$SDK/platform-tools/adb" devices 2>/dev/null | grep -c "device$" || true)"
        if [[ "$N" -gt 0 ]]; then
          echo "  ok    $N Android device(s) plugged in and authorised"
        else
          echo "        no Android phone connected (USB debugging must be on)"
        fi
      fi
    else
      echo "  MISS  Android SDK. Install Android Studio, or point Godot at an existing SDK."
    fi

    if /usr/libexec/java_home >/dev/null 2>&1; then
      echo "  ok    Java $(/usr/libexec/java_home -V 2>&1 | sed -n '2p' | awk '{print $1}')"
    else
      echo "  MISS  Java JDK 17 — Godot's Android export needs it."
    fi

    if [[ -d /Applications/Xcode.app ]]; then
      echo "  ok    Xcode installed"
    else
      echo "  MISS  Xcode — required for iOS builds. Free, large, from the Mac App Store."
    fi
    ;;
  *)
    sed -n '2,15p' "$ROOT/dev" | sed 's/^# \{0,1\}//'
    ;;
esac

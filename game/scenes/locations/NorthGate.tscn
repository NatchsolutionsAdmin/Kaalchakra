[node name="DigSite" type="Area3D" parent="Present"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.9, -9.8, -12.8)
script = ExtResource("ext_3")
prompt = "Excavate"
requires_knowledge = "keeper_mark"
dig_seconds = 2.6
grants_knowledge = "chamber_opened"
line_locked = "Brick, laid flush and mortared tight. Somebody sealed this from the outside and meant it to stay sealed. She has no reason yet to think there is anything behind it."
line_done = "The brick gives, and the dark behind it is older than the dark in front. Signs across the header — and across the header, ten of them in a row she can finally read:\n\nWHAT THE WATER MUST NOT TAKE"
remove_path = NodePath("../SealedDoor")


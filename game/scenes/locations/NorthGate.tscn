transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3, 0.7, -25)
script = ExtResource("ext_2")
prompt = "Read the Keeper's mark"
line = "A slab cut flush with the pavement, and on it one sign she does know — the Keeper's mark. Beneath it, a measure: down, under the floor of the great basin, behind a door they bricked up on purpose.  \"Four thousand years. Let's see if your masonry holds, whoever you were.\""
grants_knowledge = "keeper_mark"


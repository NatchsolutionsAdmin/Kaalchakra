transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3, -6.36, -13)
script = ExtResource("ext_3")
prompt = "Excavate"
requires_knowledge = "keeper_mark"
dig_seconds = 2.6
grants_knowledge = "chamber_opened"
line_locked = "Silt, salt, and more silt. Nothing down here marks a spot. She needs to be told where to dig — and 2026 has nobody left who knows."
line_done = "The brush turns up a lintel, then a sealed stone face, then signs — and across the header, ten of them in a row she can finally read:\n\nWHAT THE WATER MUST NOT TAKE"
reveal_path = NodePath("../ChamberHatch")


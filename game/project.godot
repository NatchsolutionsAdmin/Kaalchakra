; Engine configuration file for Kaalchakra: The Drowned City
; Godot 4.7 — standard build, GDScript, Mobile renderer, landscape
; Edit most of this safely from the editor: Project -> Project Settings.

config_version=5

[application]

config/name="Kaalchakra"
config/description="A three-era time-shift adventure set in the Indus Valley."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

TimeShift="*res://scripts/autoload/time_shift_manager.gd"
Interactions="*res://scripts/autoload/interactions.gd"
Touch="*res://scripts/autoload/touch_input.gd"
Story="*res://scripts/autoload/story.gd"
Dialogue="*res://scripts/autoload/dialogue.gd"
Audio="*res://scripts/autoload/audio_manager.gd"
Decipher="*res://scripts/autoload/decipher.gd"
Phone="*res://scripts/autoload/phone.gd"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

; Phone-shaped window for desk testing. stretch "expand" keeps the UI the same
; physical size across the many aspect ratios phones come in, rather than
; letterboxing or squashing it.
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 4 = sensor landscape: locks to landscape, lets the player flip the phone.
window/handheld/orientation=4
; Render at the Mac's real pixel density instead of upscaling a small buffer.
window/dpi/allow_hidpi=true

[input_devices]

; Mouse drags become touch events, so the whole touch scheme is testable on the
; Mac without a phone plugged in.
pointing/emulate_touch_from_mouse=true


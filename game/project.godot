[layer_names]

3d_physics/layer_1="Shared World"
3d_physics/layer_2="Past Geometry"
3d_physics/layer_3="Present Geometry"
3d_physics/layer_4="Future Geometry"
3d_physics/layer_5="Player"

[physics]

3d/default_gravity=24.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; Turning MSAA off was a mistake. Phone GPUs are tile-based, so multisampling
; resolves inside tile memory and is far cheaper there than on a desktop card
; — it is the one quality setting mobile games almost always keep. Without it
; every edge in a greybox is a hard staircase.
;
; The `.mobile` suffixed lines are what an actual phone uses; the plain ones
; are for the Mac. Revisit all of it after profiling on a real device.
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.mobile=1
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
textures/default_filters/anisotropic_filtering_level=2

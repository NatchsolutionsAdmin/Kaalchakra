; Engine configuration file for Kaalchakra: The Drowned City
; Godot 4.7 — standard build, GDScript, Forward+
; Edit most of this safely from the editor: Project -> Project Settings.

config_version=5

[application]

config/name="Kaalchakra"
config/description="A three-era time-shift adventure set in the Indus Valley."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

TimeShift="*res://scripts/autoload/time_shift_manager.gd"
Interactions="*res://scripts/autoload/interactions.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

